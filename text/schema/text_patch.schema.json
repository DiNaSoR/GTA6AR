{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dinasor.github.io/GTA6AR/schema/text_patch.schema.json",
  "title": "GTA6AR Text Patch Format",
  "description": "Schema for GTA6AR Arabic localization patch files. Stores string IDs and AI-generated Arabic text without original game assets.",
  "type": "object",
  "required": [
    "schema_version",
    "domain",
    "batch_id",
    "generated_at",
    "generator",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"],
      "description": "Version of the GTA6AR text patch schema."
    },
    "domain": {
      "type": "string",
      "enum": ["ui", "subtitles", "missions"],
      "description": "Localization domain for this patch batch."
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
      "description": "Unique identifier for this batch."
    },
    "generated_at": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp when the batch was generated."
    },
    "generator": {
      "type": "object",
      "required": [
        "model_name",
        "model_version",
        "pipeline_version",
        "glossary_version"
      ],
      "additionalProperties": false,
      "properties": {
        "model_name": {
          "type": "string",
          "description": "Approved AI model name (must be Gemini 3.8 Flash or stronger)."
        },
        "model_version": {
          "type": "string",
          "description": "Model version identifier (e.g. '3.8')."
        },
        "pipeline_version": {
          "type": "string",
          "description": "Version of tools/translate_pipeline.py used."
        },
        "glossary_version": {
          "type": "string",
          "description": "Version of text/glossary.json injected during generation."
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "ar"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique string identifier."
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$",
            "description": "Optional SHA-256 hash of the source string for local verification without storing original text."
          },
          "ar": {
            "type": "string",
            "minLength": 1,
            "description": "Formal Arabic (Fusha) translation produced by the approved AI model."
          },
          "context_category": {
            "type": "string",
            "enum": [
              "menu",
              "settings",
              "hud",
              "prompt",
              "dialogue",
              "objective",
              "notification",
              "other"
            ]
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1
          },
          "max_lines": {
            "type": "integer",
            "minimum": 1
          },
          "timing_ms": {
            "type": "object",
            "required": ["start", "end"],
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "placeholders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "glossary_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
