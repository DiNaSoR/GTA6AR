# GTA6AR Local Tooling Configuration Example
# Copy this file to `.env` locally and fill in your own API keys.
# NEVER commit `.env` or real API keys to the repository.

# 1. Translation Pipeline (Minimum: Gemini 3.8 Flash or stronger)
GEMINI_API_KEY=
GTA6AR_GEMINI_MODEL=gemini-3.8-flash
GTA6AR_GEMINI_VERSION=3.8

# 2. Voice Dubbing Pipeline (Minimum: ElevenLabs v4 or stronger)
ELEVENLABS_API_KEY=
GTA6AR_VOICE_MODEL=eleven_v4
GTA6AR_VOICE_VERSION=4.0

# 3. Images & Textures Pipeline (Minimum: OpenAI Sunburn or better)
OPENAI_API_KEY=
GTA6AR_IMAGE_MODEL=openai-sunburn
GTA6AR_IMAGE_VERSION=1.0
